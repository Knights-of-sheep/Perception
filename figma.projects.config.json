{
  "version": "1.0",
  "mode": "single-repo",
  "figma": {
    "apiBaseUrl": "https://api.figma.com/v1",
    "contextSource": "rest",
    "credentials": {
      "source": "env",
      "envVar": "FIGMA_PAT"
    }
  },
  "repo": {
    "enabled": true,
    "role": "app",
    "figmaFileId": "REPLACE_WITH_MAIN_FILE_ID",
    "pageToPackageMapping": {
      "Main": { "targetPackage": null }
    }
  },
  "excluded": []
}
