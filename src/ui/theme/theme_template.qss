/* ==========================================================================
   Perception 主题模板 theme_template.qss
   规范：docs/design/ui-guidelines.md §3 / §4
   token 占位符（唯一来源 theme/theme_catalog.h，运行时渲染替换）：
     @windowBg@ @panelBg@ @controlBg@ @viewBg@
     @text@ @textWeak@ @textDisabled@ @border@ @borderWeak@
     @accent@ @accentHover@ @accentPressed@ @selectionBg@
     @hoverBg@ @surfaceElev@ @itemHover@ @buttonHover@ @handleHover@
     @dockTitleBg@ @dangerText@ @dangerHoverBg@
     @success@ @warning@ @danger@
     @white@ @textOnSelection@ @textOnAccent@
   覆盖范围：ui-guidelines §4.1 控件矩阵（全家族 x 全状态）
   ========================================================================== */

/* ===== 窗口 ===== */
QMainWindow, QDialog, QMessageBox {
    background-color: @windowBg@;   /* BG_WINDOW */
    color: @text@;                  /* FG_TEXT */
}

/* ===== 通用控件文字 ===== */
QWidget {
    color: @text@;
    font-size: 9pt;
}

/* ===== 菜单栏 ===== */
QMenuBar {
    background-color: @panelBg@;   /* BG_PANEL */
    border-bottom: 1px solid @border@;  /* BORDER */
    padding: 2px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected { background: @hoverBg@; }   /* BG_CONTROL */
QMenuBar::item:pressed  { background: @selectionBg@; }   /* SELECTION_BG */

/* ===== 无边框自定义标题栏（标题 + 窗口按钮，与菜单栏同一行）===== */
QWidget#titleBarRow {
    background-color: @panelBg@;   /* 与菜单栏同底色 */
    border-bottom: 1px solid @border@;  /* 整行底部分隔线 */
}
QWidget#titleBarRow QMenuBar {
    background: transparent;   /* 底色交给 titleBarRow */
    border-bottom: none;       /* 避免双重分隔线 */
}
QWidget#titleBar {
    background: transparent;
}
QWidget#titleBarDragArea {
    background: transparent;   /* 拖拽区：无视觉元素，仅承接鼠标 */
}
QLabel#titleBarIcon {
    background: transparent;
}
QLabel#titleBarTitle {
    background: transparent;
    color: @text@;             /* TEXT_PRIMARY */
    font-weight: 600;
}
QToolButton#winMinBtn, QToolButton#winMaxBtn, QToolButton#winCloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    /* 图标为 QPainter 统一 16px 矢量（makeWinBtnIcon），颜色随主题 palette，
       不再用字符，故无需 font/color 属性 */
}
QToolButton#winMinBtn:hover, QToolButton#winMaxBtn:hover {
    background: @hoverBg@;     /* BG_CONTROL */
}
QToolButton#winCloseBtn:hover {
    background: @dangerHoverBg@;   /* 关闭悬停红（Windows 惯例），图标 hover 取白色 */
}

/* ===== 菜单（弹出层）===== */
QMenu {
    background-color: @controlBg@;   /* BG_CONTROL */
    border: 1px solid @border@;   /* BORDER */
    padding: 4px;
}
QMenu::item {
    padding: 5px 24px 5px 12px;
    border-radius: 4px;
}
QMenu::item:selected { background: @selectionBg@; color: @textOnSelection@; }
QMenu::item:disabled { color: @textDisabled@; }           /* FG_TEXT_DISABLED */
QMenu::separator { height: 1px; background: @border@; margin: 4px 8px; }

/* ===== 工具栏 ===== */
QToolBar {
    background-color: @panelBg@;   /* BG_PANEL */
    border-bottom: 1px solid @border@;
    spacing: 2px;
    padding: 3px 6px;
}
QToolBar::separator { width: 1px; background: @border@; margin: 3px 4px; }
QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 6px;
}
QToolButton:hover   { background: @hoverBg@; }
/* pressed/checked 文字随选中底色（如 hc-white 黑字深蓝底需换白字） */
QToolButton:pressed { background: @selectionBg@; color: @textOnSelection@; }
QToolButton:checked { background: @selectionBg@; color: @textOnSelection@; }
QToolButton:disabled { color: @textDisabled@; }

/* ===== 功能栏（左侧/右侧纵向，ToolButtonIconOnly，iconSize 24 由代码设置）===== */
/* 五态容器（contracts/icon-action-map.md §5）：
   normal 透明 / hover=BG_CONTROL 圆角 4px / pressed=加深 / checked=SELECTION_BG；
   disabled 图标由 IconFactory 染色派生。 */
QToolBar#leftToolBar, QToolBar#rightToolBar {
    background-color: @panelBg@;   /* BG_PANEL */
    border: none;
    spacing: 4px;
    padding: 6px 4px;
}
/* 功能栏与内部组件（dock/中央）之间的 1px 边界线：垂直栏方向是 border-right/left，
   复用 BORDER 分隔线 token（ui-guidelines §3），与 QSplitter/dock 边框体系一致。 */
QToolBar#leftToolBar {
    border: none;
    border-right: 1px solid @border@;
}
QToolBar#rightToolBar {
    border: none;
    border-left: 1px solid @border@;
}
QToolBar#leftToolBar QToolButton, QToolBar#rightToolBar QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}
QToolBar#leftToolBar QToolButton:hover,
QToolBar#rightToolBar QToolButton:hover {
    background: @hoverBg@;          /* BG_CONTROL */
}
QToolBar#leftToolBar QToolButton:pressed,
QToolBar#rightToolBar QToolButton:pressed {
    background: @selectionBg@;      /* BG_CONTROL 加深 */
    color: @textOnSelection@;
}
QToolBar#leftToolBar QToolButton:checked,
QToolBar#rightToolBar QToolButton:checked {
    background: @selectionBg@;      /* SELECTION_BG（selected 容器）*/
    color: @textOnSelection@;
}

/* ===== 按钮 ===== */
QPushButton {
    background-color: @controlBg@;   /* BG_CONTROL */
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 5px 14px;
}
QPushButton:hover   { background-color: @buttonHover@; }
QPushButton:pressed { background-color: @selectionBg@; }
QPushButton:disabled {
    color: @textDisabled@;
    background-color: @surfaceElev@;
    border-color: @borderWeak@;
}
QPushButton:default, QPushButton[emphasis="primary"] {
    background-color: @accent@;   /* ACCENT */
    color: @textOnAccent@;
    border-color: @accent@;
}
QPushButton:default:hover, QPushButton[emphasis="primary"]:hover {
    background-color: @accentHover@;
}
QPushButton:default:pressed, QPushButton[emphasis="primary"]:pressed {
    background-color: @accentPressed@;
}

/* ===== 输入控件 ===== */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: @controlBg@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: @accent@;
    selection-color: @textOnAccent@;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border-color: @accent@;       /* ACCENT 焦点环（几何一致性） */
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: @controlBg@;
    border: 1px solid @border@;
    selection-background-color: @selectionBg@;
    selection-color: @textOnSelection@;
    outline: none;
}

/* ===== Dock ===== */
/* 自定义标题栏（修复 Qt5+Fusion 下浮动态不绘制 normal-button 的问题）：
   通过 QDockWidget::setTitleBarWidget(DockTitleBar) 接管，按钮显式 QToolButton。
   注：QDockWidget 自身的 border 在 QMainWindow 内部不绘制（QDockAreaLayout 管理，
   QSS 不走标准渲染路径），改用 QDockWidget > QWidget 选 dock 内容 wrap widget
   （MainWindow::wrapWithSizeGrip 构造的 QWidget+QGridLayout+QTreeWidget/PythonConsole）
   加 1px 边框——视觉上等同 dock 外缘描边；与 QToolBar#left/right border 邻接时形成
   2px 强分隔条。 */
QDockWidget {
    background-color: @panelBg@;   /* BG_PANEL */
    color: @textWeak@;              /* FG_TEXT_WEAK */
}
QDockWidget > QWidget {
    border: 1px solid @border@;     /* dock 内容外缘描边（绕开 QSS 限制） */
}
QWidget#dockTitleBar {
    background-color: @dockTitleBg@;
    border-bottom: 1px solid @borderWeak@;
    min-height: 26px;
}
QLabel#dockTitleLabel {
    color: @text@;
    font-weight: 600;
    background: transparent;
}
QToolButton#dockMinBtn, QToolButton#dockMaxBtn,
QToolButton#dockFloatBtn, QToolButton#dockCloseBtn {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 0;
}
QToolButton#dockMinBtn:hover, QToolButton#dockMaxBtn:hover,
QToolButton#dockFloatBtn:hover, QToolButton#dockCloseBtn:hover {
    background: @hoverBg@;
}
QToolButton#dockCloseBtn:hover {
    background: @dangerHoverBg@;
}
/* 浮动面板右下角调整大小手柄（去系统标题栏后唯一的 resize 入口，停靠时隐藏） */
QSizeGrip#dockSizeGrip {
    background: transparent;
    width: 12px;
    height: 12px;
}

/* ===== 树 / 列表 / 表 ===== */
QTreeWidget, QTreeView, QListView, QTableView {
    background-color: @panelBg@;
    alternate-background-color: @surfaceElev@;
    border: 1px solid @border@;   /* dock 内容 widget 自身描边 = 视觉 dock 边；
                                      QDockWidget 自身 border 在 QMainWindow 内不绘制，
                                      wrap container 也不延伸到 dock 边缘，只有直接给
                                      内容 widget（QTreeWidget / QPlainTextEdit）加边
                                      才能稳定画出 dock 外缘；fileTree/propertyTree 占满
                                      wrap container 内容区，QTreeWidget 外缘 ≈ dock 边。 */
    outline: none;
}
QTreeView::item, QListView::item, QTableView::item {
    padding: 4px 6px;
    border: none;
    border-radius: 4px;
}
QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background: @itemHover@;
}
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background: @selectionBg@;         /* SELECTION_BG */
    color: @textOnSelection@;
}
QHeaderView::section {
    background-color: @surfaceElev@;
    color: @textWeak@;
    border: none;
    border-right: 1px solid @borderWeak@;
    border-bottom: 1px solid @borderWeak@;
    padding: 4px 8px;
}
QTreeView::branch { background: transparent; }

/* ===== 滚动条（横/纵，三态）===== */
QScrollBar:vertical {
    background: @panelBg@;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: @border@;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover   { background: @handleHover@; }
QScrollBar::handle:vertical:pressed { background: @accent@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: @panelBg@;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: @border@;
    border-radius: 4px;
    min-width: 24px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover   { background: @handleHover@; }
QScrollBar::handle:horizontal:pressed { background: @accent@; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ===== 状态栏 ===== */
QStatusBar {
    background-color: @windowBg@;   /* BG_WINDOW */
    border-top: 1px solid @border@;
    color: @textWeak@;
}
QStatusBar::item { border: none; }

/* ===== 分割 ===== */
/* Dock 之间/与中央区用强分隔线（1px @border@ 已通过 QDockWidget border + QToolBar
   border-right/left 各自描边，相邻边对边 = 2px 强色带，本类目仅负责 splitter 句柄
   与多文档子窗口间水平/垂直把手；保持 2px @border@ 增强深色主题下可见性。
   注：QMainWindow 的 Dock 分隔条是内部 QMainWindowLayoutSeparator（非 QSplitter），
   QSplitter::handle 对其无效；但 QMainWindow::separator 的 width/height 会压缩
   分隔条尺寸（默认约 4px）导致拖拽区域过窄，故此处不覆盖，保持默认尺寸。 */
QSplitter::handle { background: @border@; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }
QSplitter::handle:hover { background: @accent@; }

/* ===== ToolTip（弹层，禁默认黄底）===== */
QToolTip {
    background-color: @controlBg@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ===== Tab（预留）===== */
QTabWidget::pane {
    border: 1px solid @border@;
    background: @panelBg@;
}
QTabBar::tab {
    background: @surfaceElev@;
    color: @textWeak@;
    padding: 6px 14px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}
QTabBar::tab:selected { background: @panelBg@; color: @text@; }
QTabBar::tab:hover { color: @text@; }

/* ===== 中央视图空状态（BG_VIEW）===== */
QLabel#centralPlaceholder {
    color: @textWeak@;
    font-size: 12pt;
    background-color: @viewBg@;   /* BG_VIEW */
}

/* ===== 子窗口容器（004-dock-layout-manager）===== */
QWidget#subwindowContainer {
    background-color: @viewBg@;   /* BG_VIEW */
}
/* SubwindowView 的边框/背景实际由 paintEvent 自绘接管（QPainter，见 subwindow_view.cpp），
   规避 QStyleSheetStyle 对 QFrame border 几何宽度的 lineWidth 钳制；以下 QSS 仅作语义参考。 */
QFrame#subwindowView {           /* SubwindowView 继承 QFrame（WA_StyledBackground 启用） */
    background-color: @panelBg@;
    border: 1px solid @border@;   /* 未选中：1px 边框（弱化存在感，聚焦内容） */
}
QFrame#subwindowView[selected="true"] {
    border: 2px solid @border@;   /* 选中：仅加粗为 2px，颜色保持 @border@（无强调色） */
}
/* titleBar_ 已设 WA_TranslucentBackground：背景 @dockTitleBg@ 与底部分隔线 @borderWeak@
   由 SubwindowView::paintEvent 自绘（见 subwindow_view.cpp），本规则仅作语义参考。 */
QWidget#subwindowTitleBar {
    background-color: @dockTitleBg@;
    border-bottom: 1px solid @borderWeak@;
}
QLabel#subwindowTitleLabel {
    color: @text@;
    font-weight: 600;
    background: transparent;
}
QToolButton#subwindowMaxBtn, QToolButton#subwindowHideBtn,
QToolButton#subwindowRestoreBtn, QToolButton#subwindowPrevBtn,
QToolButton#subwindowNextBtn, QToolButton#subwindowCloseBtn {
    background: transparent;
    border: none;
    border-radius: 3px;
}
QToolButton#subwindowMaxBtn:hover, QToolButton#subwindowHideBtn:hover,
QToolButton#subwindowRestoreBtn:hover, QToolButton#subwindowPrevBtn:hover,
QToolButton#subwindowNextBtn:hover, QToolButton#subwindowCloseBtn:hover {
    background: @hoverBg@;   /* BG_CONTROL */
}
QToolButton#subwindowCloseBtn:hover {
    background: @dangerHoverBg@;   /* 关闭按钮 hover 红色底（与其他窗口控制一致） */
}
/* content_ 已设 WA_TranslucentBackground，父 SubwindowView::paintEvent 自绘 @panelBg@ 背景；
   此规则若保留会遮挡父背景，故移除（子窗口内容区背景统一由 SubwindowView 负责）。 */

/* 布局设置对话框（US5：深/浅主题均可读） */
QDialog#layoutSettingsDialog QLabel {
    color: @text@;
}
QDialog#layoutSettingsDialog QSpinBox {
    background-color: @controlBg@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 2px 4px;
    min-width: 90px;
}
QDialog#layoutSettingsDialog QComboBox {
    background-color: @controlBg@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 3px 8px;
    min-width: 120px;
}
QDialog#layoutSettingsDialog QCheckBox {
    color: @text@;
}
QDialog#layoutSettingsDialog QRadioButton {
    color: @text@;
}
QDialog#layoutSettingsDialog QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @border@;
    border-radius: 7px;
    background: @controlBg@;
}
QDialog#layoutSettingsDialog QRadioButton::indicator:checked {
    border: 4px solid @accent@;
    background: @windowBg@;
}

/* ===== Python 控制台（底部 Dock，内嵌 REPL）===== */
/* 容器：控制台区域带弱边框，与 Dock 标题栏、右侧操作栏区分 */
QWidget#pythonConsoleContainer {
    background-color: @panelBg@;
}
QPlainTextEdit#pythonConsole {
    background-color: @controlBg@;
    color: @text@;
    border: 1px solid @border@;   /* 与 QTreeWidget 一致：占满 pythonContainer 外缘 = dock 视觉边 */
    border-radius: 0;
    padding: 0;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10pt;
}
QPlainTextEdit#pythonConsole:focus { /* 去掉 focus 时 border-color: @accent@：
                                  pythonConsole 是 dock 内主控件并占满内容区，
                                  边框亮起会被误读为 dock 边框——与 fileDock/propertyDock 的
                                  QTreeWidget 风格一致（不画 focus 边框） */ }
/* 右侧操作栏：垂直排列"导出命令 / 清空控制台" */
QWidget#pythonSideBar {
    background-color: @panelBg@;
    border-left: 1px solid @borderWeak@;
}
QToolButton#pythonExportBtn, QToolButton#pythonClearBtn {
    background-color: @controlBg@;
    border: 1px solid @border@;
    border-radius: 4px;
    color: @text@;
    font-size: 9pt;
    padding: 2px 4px;
}
QToolButton#pythonExportBtn:hover, QToolButton#pythonClearBtn:hover {
    background-color: @buttonHover@;
}
QToolButton#pythonExportBtn:pressed, QToolButton#pythonClearBtn:pressed {
    background-color: @selectionBg@;
    color: @textOnSelection@;
}
/* 清空是破坏性操作：弱化默认态、hover 显红，降低误触 */
QToolButton#pythonClearBtn {
    color: @textWeak@;
}
QToolButton#pythonClearBtn:hover {
    background-color: @dangerHoverBg@;
    color: @white@;
    border-color: @danger@;
}
